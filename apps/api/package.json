{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run --filter @grandcharter/shared build && pnpm run --filter @grandcharter/db build",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test dist/storage/storage.test.js dist/service/filesystem.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@grandcharter/db": "workspace:*",
    "@grandcharter/shared": "workspace:*",
    "fastify": "^4.28.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
